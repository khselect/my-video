# --- dependencies / OS ---
node_modules
dist
.DS_Store
Thumbs.db
__pycache__/
*.pyc

# --- secrets & per-machine settings ---
.env
.env.*
!.env.example
studio/config.local.json

# --- generated (rebuildable) ---
out
build/
lectures/*/build/
lectures/*/node_modules/
lectures/*/.hyperframes/
lectures/*/assets/vendor/
lectures/*/assets/fonts/
lectures/*/assets/voice/
lectures/*/source/pages/

# --- renders: keep the manifest, not the videos ---
renders/*.mp4
renders/*.webm
renders/*.mov
lectures/*/renders/*.mp4
lectures/*/renders/*.webm
lectures/*/renders/*.mov
!**/renders/manifest.json

# --- voice: never commit voice recordings or clone profiles ---
voices/
*.ref.wav
*.pt

# --- large media sources (PDF/HTML are tracked) ---
sources/*.mp4
sources/*.mov
sources/*.wav

# --- imported video-style skills (third-party, per machine; manifests live in studio/styles/) ---
video-skills/
lectures/*/style-*/node_modules/
lectures/*/style-*/film/
lectures/*/style-*/qa/
lectures/*/style-*/*.mp4
lectures/*/style-*/**/*.mp4
# reference screenshots are third-party (e.g. TED: CC BY-NC-ND) — keep only the written style memo (brief.md)
lectures/*/style-ref/*.png
lectures/*/style-ref/*.jpg
lectures/*/style-ref/*.jpeg
lectures/*/style-ref/*.webp
# reference videos and frames taken from them are third-party too; the measured numbers (spec.json/md) are kept
lectures/*/style-ref/reference.*
lectures/*/style-ref/measure/*.jpg
